# Port for the Express tutor proxy (Vite proxies /api to it)
API_PORT=3001

# The tutor runs on Claude. Without a key, hint and error requests say how to connect.
ANTHROPIC_API_KEY=

# Optional model overrides (default: claude-sonnet-5-5 for hints and error
# explanations; the fast tier is currently unused). claude-opus-5-5 also works.
# TUTOR_MODEL_FAST=claude-haiku-5-5
# TUTOR_MODEL_STRONG=claude-sonnet-5-5

# Force the stub (no model calls), e.g. for offline work.
# TUTOR_PROVIDER=stub

# Tutor requests allowed per minute from one client (default 60).
# TUTOR_RATE_LIMIT=60
