# Port for the Express tutor proxy (Vite proxies /api to it)
API_PORT=3001

# The tutor runs through OpenRouter (https://openrouter.ai/keys). Without a key,
# hint and error requests say how to connect.
OPENROUTER_API_KEY=

# Optional model overrides, any OpenRouter model id (default: the free
# nvidia/nemotron-3-ultra-550b-a55b:free for both; the fast tier is currently unused).
# TUTOR_MODEL_FAST=nvidia/nemotron-3-ultra-550b-a55b:free
# TUTOR_MODEL_STRONG=nvidia/nemotron-3-ultra-550b-a55b:free

# Force the stub (no model calls), e.g. for offline work.
# TUTOR_PROVIDER=stub

# Tutor requests allowed per minute from one client (default 60; 20 in production).
# TUTOR_RATE_LIMIT=60

# Tutor requests allowed per UTC day from everyone together (production default 300).
# TUTOR_DAILY_LIMIT=300
