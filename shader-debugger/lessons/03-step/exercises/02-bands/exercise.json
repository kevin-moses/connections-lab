{
  "title": "Bands",
  "tests": [
    {
      "type": "pixel",
      "label": "x = 0.2 is black",
      "at": [
        0.2,
        0.5
      ],
      "expect": [
        0,
        0,
        0
      ],
      "tol": 0.02
    },
    {
      "type": "pixel",
      "label": "x = 0.5 is white",
      "at": [
        0.5,
        0.5
      ],
      "expect": [
        1,
        1,
        1
      ],
      "tol": 0.02
    },
    {
      "type": "pixel",
      "label": "x = 0.8 is black",
      "at": [
        0.8,
        0.5
      ],
      "expect": [
        0,
        0,
        0
      ],
      "tol": 0.02
    }
  ],
  "predict": {
    "question": "`1.0 - step(0.7, uv.x)` flips a step. What is it at **x = 0.9**?",
    "at": [
      0.9,
      0.5
    ],
    "expr": "1.0 - step(0.7, uv.x)",
    "kind": "number",
    "tolerance": 0.01,
    "explain": "step(0.7, 0.9) is 1 (0.9 is past the edge), so 1 \u2212 1 = **0**. Flipped steps are 1 *below* the edge and 0 above it."
  }
}
